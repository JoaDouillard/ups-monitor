# --- Onduleur Eaton ---
UPS_HOST=192.168.1.100
UPS_PORT=161

# --- SNMPv3 ---
SNMP_USER=upsnms
SNMP_AUTH_KEY=MonMotDePasseAuth
SNMP_PRIV_KEY=MonMotDePassePriv
# Protocoles supportés : SHA / SHA224 / SHA256 / SHA384 / SHA512
SNMP_AUTH_PROTOCOL=SHA
# Protocoles supportés : AES / AES192 / AES256 / DES
SNMP_PRIV_PROTOCOL=AES
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# --- Polling ---
# Intervalle en secondes entre chaque interrogation SNMP
POLL_INTERVAL=30

# --- Application ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEZ_MOI_ABSOLUMENT
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_AUSSI
# Durée de validité du token JWT en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Base de données ---
DATABASE_URL=sqlite+aiosqlite:///./ups_monitor.db
# Rétention de l'historique en jours
HISTORY_RETENTION_DAYS=30

# --- Alertes email (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ups-monitor@local
ALERT_EMAIL_TO=admin@local
SMTP_TLS=true

# --- XenServer (pour le shutdown) ---
XENSERVER_HOST=192.168.1.1
XENSERVER_USER=root
XENSERVER_PASSWORD=
# Délai avant arrêt des VMs en secondes
SHUTDOWN_DELAY_SECONDS=60
